# =============================================================================
# TURAGENT v2.0 — .env.example
# =============================================================================
# Копируйте этот файл в .env и заполните значения.
# .env НЕ коммитится в git (.gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------
# Токен бота из @BotFather. Формат: 123456:ABC-DEF...
# Получить новый токен: написать @BotFather → /newbot → seguir instrucciones
# Бот: turoperatorKroft_bot (ID 8717684744)
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# ---------------------------------------------------------------------------
# Ollama / LLM
# ---------------------------------------------------------------------------
# Ollama server address. Default: http://localhost:11434
OLLAMA_BASE_URL="http://localhost:11434"

# Модель по умолчанию. Поддерживаемые: llama3.2, qwen2.5:7b, ...
# Проверить доступные модели: curl http://localhost:11434/api/tags
OLLAMA_MODEL="llama3.2"

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Для dev-режима (локальная БД без пароля):
#   DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/turagent
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://turagent:turagent@localhost:5432/turagent"
DATABASE_URL_SYNC="postgresql://turagent:turagent@localhost:5432/turagent"

# ---------------------------------------------------------------------------
# pgvector
# ---------------------------------------------------------------------------
# Включить pgvector extension (создаётся автоматически при первой миграции):
# CREATE EXTENSION IF NOT EXISTS vector;
# Нет отдельной настройки — используется как часть PostgreSQL.

# ---------------------------------------------------------------------------
# Debug / Dev
# ---------------------------------------------------------------------------
# Включить SQL-логирование (echo): "1" / "0"
DB_ECHO="0"

# Размер пула соединений
DB_POOL_SIZE="5"

# Максимальное переполнение пула
DB_MAX_OVERFLOW="10"

# Режим разработки: пропуск некоторых проверок
DEV_MODE="0"

# ---------------------------------------------------------------------------
# External APIs (PHASE 8 — опционально)
# ---------------------------------------------------------------------------
# Amadeus API credentials (нужно зарегистрироваться на amadeus.com)
# AMADEUS_API_KEY=""
# AMADEUS_API_SECRET=""

# Booking.com Demand API credentials
# BOOKING_API_KEY=""
# BOOKING_API_SECRET=""

# ---------------------------------------------------------------------------
# Файловое хранилище
# ---------------------------------------------------------------------------
# Папка для загруженных документов (PDF, DOCX, XLSX, TXT)
UPLOAD_DIR="./uploads"

# Папка для временных файлов
TEMP_DIR="./temp"
